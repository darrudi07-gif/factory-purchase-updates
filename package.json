{
  "name": "factory-purchase-desktop",
  "version": "7.0.0",
  "private": true,
  "description": "دفتر خرید و تسویه کارخانه",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "publish:win": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ir.factory.purchase",
    "productName": "Factory Purchase",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "دفتر خرید کارخانه"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "darrudi07-gif",
        "repo": "factory-purchase-updates",
        "releaseType": "release"
      }
    ]
  }
}